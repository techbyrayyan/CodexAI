// ==============================================================================
// JARVIS AI ASSISTANT — DATABASE SCHEMA (PHASE 1 FOUNDATION)
// Prepared for PostgreSQL via Prisma ORM
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for personalized context, preferences, and session ownership
model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  tasks         Task[]
  activities    ActivityLog[]

  @@map("users")
}

// Conversation model for session persistence and thread tracking
model Conversation {
  id        String       @id @default(uuid())
  userId    String?
  title     String
  status    String       @default("active") // active, archived, deleted
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

// Message model for individual user and assistant turns
model Message {
  id             String        @id @default(uuid())
  conversationId String
  role           String        // user, assistant, system, tool
  content        String
  metadata       Json?         // tool calls, tokens, latency, audio refs
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Future task tracking for autonomous multi-step operations
model Task {
  id          String    @id @default(uuid())
  userId      String?
  title       String
  description String?
  status      String    @default("pending") // pending, in_progress, completed, failed
  priority    String    @default("normal")  // low, normal, high, critical
  payload     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// System activity log for security auditing and telemetry
model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  category  String   // system, ai, tool, security, network
  action    String
  details   Json?
  level     String   @default("info") // debug, info, warn, error
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// Record of tool calls for permission audits and execution history
model ToolExecution {
  id         String   @id @default(uuid())
  toolName   String
  inputArgs  Json
  output     Json?
  isSuccess  Boolean  @default(false)
  durationMs Int
  caller     String   @default("jarvis-core")
  createdAt  DateTime @default(now())

  @@map("tool_executions")
}
